#!/bin/bash
# run_onchange_after_26-sops-age-key.sh -*- mode: sh; -*-

# Restore the sops age key from 1Password on a fresh machine.
# The key is stored as document "sops-age-key" in the Automation vault;
# sops reads it from its default macOS location automatically.

{{ if not .useOp -}}
echo "sops-age-key: useOp disabled, skipping (place the key manually if needed)."
exit 0
{{ end -}}

KEY_FILE="$HOME/Library/Application Support/sops/age/keys.txt"

if [ -s "$KEY_FILE" ]; then
  exit 0
fi

if ! command -v op >/dev/null 2>&1; then
  echo "sops-age-key: 1Password CLI not available, skipping (rerun chezmoi apply later)."
  exit 0
fi

mkdir -p "$(dirname "$KEY_FILE")"
if op document get "sops-age-key" --vault Automation > "$KEY_FILE" 2>/dev/null; then
  chmod 600 "$KEY_FILE"
  echo "sops-age-key: restored from 1Password."
else
  rm -f "$KEY_FILE"
  echo "sops-age-key: could not fetch from 1Password (locked or missing), skipping."
fi
