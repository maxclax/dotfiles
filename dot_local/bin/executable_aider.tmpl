#!/bin/bash
# aider.sh -*- mode: sh; -*-
# Wrapper shadowing the real aider (~/.local/bin is first in PATH):
# API keys are fetched from 1Password at launch and live only in this
# process' environment — nothing at rest in ~/.aider.conf.yml.

real="$(which -a aider | grep -v "$HOME/.local/bin/aider" | head -1)"
if [ -z "$real" ]; then
  echo "aider wrapper: real aider binary not found in PATH" >&2
  exit 127
fi

{{ if .useOp -}}
if command -v op >/dev/null 2>&1; then
  export OPENAI_API_KEY="${OPENAI_API_KEY:-$(op read "op://Automation/api.openai.com/apikey" 2>/dev/null)}"
  export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-$(op read "op://Automation/api.anthropic.com/apikey" 2>/dev/null)}"
  export GEMINI_API_KEY="${GEMINI_API_KEY:-$(op read "op://Automation/generativelanguage.googleapis.com/apikey" 2>/dev/null)}"
  export DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-$(op read "op://Automation/api.deepseek.com/apikey" 2>/dev/null)}"
  zai_key="$(op read "op://Automation/api.z.ai/api/anthropic/apikey" 2>/dev/null)"
  if [ -n "$zai_key" ]; then
    exec "$real" --api-key "z-pu=$zai_key" "$@"
  fi
fi
{{ end -}}

exec "$real" "$@"
