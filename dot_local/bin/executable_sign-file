#!/usr/bin/env python3
"""sign-file — CAdES (.p7s) signatures via ІІТ EUSignCP (euscp.dylib) and JKS key stores.

Keys come from one 1Password item, or from environment variables.

The 1Password item (title `eusign` by default) holds one section per key. The
section name is the profile name. Each section has a `password` field, the key
store attached as a file, and optionally an `alias` field. A key store may also
be attached to the item itself as `<profile>.jks`.

Env:
  EUSIGN_KEY           default profile (same as --key)
  EUSIGN_OP_ITEM       1Password item title (default: eusign)
  EUSIGN_OP_VAULT      1Password vault, if the title is not unique
  EUSIGN_JKS           key store path, used when no profile is selected
  EUSIGN_JKS_PASSWORD  its password (env only, never argv)
  EUSIGN_ALIAS         its key alias (required if the store holds several keys)
  EUSIGN_LIB_DIR       library dir (default: ~/opt/eusign/lib)
  EUSIGN_CERTS_DIR     certificate file store (default: ~/opt/eusign/certs)

Usage:
  sign-file --keys                              list profiles
  sign-file [--key NAME] --list                 list aliases in the key store
  sign-file [--key NAME] --check                confirm the password opens the key
  sign-file [--key NAME] --info                 certificate validity (no password)
  sign-file --set-key NAME JKS                  add or renew a profile (asks for the password)
  sign-file --delete-key NAME                   remove a profile
  sign-file [--key NAME] [--level bes|t|x-long] <input> [output.p7s]
  sign-file [--key NAME] --attached <input> [output.p7s]
  sign-file --inspect <file.p7s>                report a signature's level

Default is a detached signature (.p7s beside the original); --attached embeds
the data in the .p7s. The default level is x-long: a timestamp plus certificate
and revocation data, from the servers CAs.json lists for the signer's issuer.
"""
from __future__ import annotations

import argparse
import datetime
import getpass
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import ctypes
from ctypes import (
    POINTER,
    Structure,
    byref,
    c_char_p,
    c_int,
    c_ubyte,
    c_ulong,
    c_void_p,
)

EU_ERROR_NONE = 0
EU_ERROR_WARNING_END_OF_ENUM = 7
BOOL = c_int
DWORD = c_ulong  # ІІТ's DWORD is unsigned long: 8 bytes on macOS
PBYTE = POINTER(c_ubyte)
PPBYTE = POINTER(PBYTE)
PDWORD = POINTER(DWORD)
PPDWORD = POINTER(PDWORD)

LEVELS = {"bes": 0x01, "t": 0x04, "x-long": 0x10}
LEVEL_NAMES = ["CAdES-BES", "CAdES-T", "CAdES-C", "CAdES-X Long"]
WANTED = {"bes": "CAdES-BES", "t": "CAdES-T", "x-long": "CAdES-X Long"}
AA = "1.2.840.113549.1.9.16.2."
OID_TIMESTAMP = AA + "14"
OID_REFS = (AA + "21", AA + "22")
OID_VALUES = (AA + "23", AA + "24")
OID_SIGNING_TIME = "1.2.840.113549.1.9.5"
APPLE_PYTHON = "/usr/bin/python3"


class EU_CERT_OWNER_INFO(Structure):
    _pack_ = 1  # ІІТ packs this struct: the pointers start at byte 4
    _layout_ = "ms"
    _fields_ = [
        ("bFilled", BOOL),
        ("pszIssuer", c_char_p),
        ("pszIssuerCN", c_char_p),
        ("pszSerial", c_char_p),
        ("pszSubject", c_char_p),
        ("pszSubjCN", c_char_p),
        ("pszSubjOrg", c_char_p),
        ("pszSubjOrgUnit", c_char_p),
        ("pszSubjTitle", c_char_p),
        ("pszSubjState", c_char_p),
        ("pszSubjLocality", c_char_p),
        ("pszSubjFullName", c_char_p),
        ("pszSubjAddress", c_char_p),
        ("pszSubjPhone", c_char_p),
        ("pszSubjEMail", c_char_p),
        ("pszSubjDNS", c_char_p),
        ("pszSubjEDRPOUCode", c_char_p),
        ("pszSubjDRFOCode", c_char_p),
    ]


def die(msg: str, code: int = 1) -> None:
    print(f"sign-file: {msg}", file=sys.stderr)
    raise SystemExit(code)


def lib_dir() -> str:
    d = os.environ.get("EUSIGN_LIB_DIR") or os.path.expanduser("~/opt/eusign/lib")
    if not os.path.isdir(d):
        die(f"EUSign lib dir missing: {d} (run chezmoi eusign install hook)")
    return d


def certs_dir() -> str:
    d = os.environ.get("EUSIGN_CERTS_DIR") or os.path.expanduser("~/opt/eusign/certs")
    os.makedirs(d, exist_ok=True)
    return d


def load_euscp():
    d = lib_dir()
    # Stay in lib dir so @loader_path / sibling km.*.dylib resolve (SIP-safe).
    os.chdir(d)
    try:
        lib = ctypes.CDLL(os.path.join(d, "euscp.dylib"))
    except OSError as e:
        die(f"failed to load euscp.dylib from {d}: {e}")

    lib.EUSetUIMode.argtypes = [BOOL]
    lib.EUSetUIMode.restype = None
    lib.EUInitialize.argtypes = []
    lib.EUInitialize.restype = DWORD
    lib.EUIsInitialized.argtypes = []
    lib.EUIsInitialized.restype = BOOL
    lib.EUFinalize.argtypes = []
    lib.EUFinalize.restype = DWORD
    lib.EUGetErrorDesc.argtypes = [DWORD]
    lib.EUGetErrorDesc.restype = c_char_p

    lib.EUSetFileStoreSettings.argtypes = [
        c_char_p, BOOL, BOOL, BOOL, BOOL, BOOL, BOOL, DWORD
    ]
    lib.EUSetFileStoreSettings.restype = DWORD

    # Prefer in-memory JKS APIs — File* variants fail on emoji/iCloud paths.
    lib.EUEnumJKSPrivateKeys.argtypes = [PBYTE, DWORD, DWORD, POINTER(c_char_p)]
    lib.EUEnumJKSPrivateKeys.restype = DWORD

    # Order per IIT NIXes CPP appendix:
    #   priv, privLen, certsCount, certs**, certLens**
    lib.EUGetJKSPrivateKey.argtypes = [
        PBYTE,
        DWORD,
        c_char_p,
        POINTER(PBYTE),
        PDWORD,
        PDWORD,
        POINTER(PPBYTE),
        POINTER(PDWORD),
    ]
    lib.EUGetJKSPrivateKey.restype = DWORD

    lib.EUFreeMemory.argtypes = [c_void_p]
    lib.EUFreeMemory.restype = DWORD
    # count first: the other order aborts the process
    lib.EUFreeCertificatesArray.argtypes = [DWORD, PPBYTE, PDWORD]
    lib.EUFreeCertificatesArray.restype = None
    lib.EUSaveCertificate.argtypes = [PBYTE, DWORD]
    lib.EUSaveCertificate.restype = DWORD
    lib.EUReadPrivateKeyBinary.argtypes = [
        PBYTE, DWORD, c_char_p, POINTER(EU_CERT_OWNER_INFO)
    ]
    lib.EUReadPrivateKeyBinary.restype = DWORD
    lib.EUFreeCertOwnerInfo.argtypes = [POINTER(EU_CERT_OWNER_INFO)]
    lib.EUFreeCertOwnerInfo.restype = DWORD
    lib.EUResetPrivateKey.argtypes = []
    lib.EUResetPrivateKey.restype = None
    lib.EUSignFile.argtypes = [c_char_p, c_char_p, BOOL]
    lib.EUSignFile.restype = DWORD

    lib.EUSetRuntimeParameter.argtypes = [c_char_p, c_void_p, DWORD]
    lib.EUSetRuntimeParameter.restype = DWORD
    lib.EUSetModeSettings.argtypes = [BOOL]
    lib.EUSetModeSettings.restype = DWORD
    lib.EUSetOCSPSettings.argtypes = [BOOL, BOOL, c_char_p, c_char_p]
    lib.EUSetOCSPSettings.restype = DWORD
    lib.EUSetOCSPAccessInfoModeSettings.argtypes = [BOOL]
    lib.EUSetOCSPAccessInfoModeSettings.restype = DWORD
    lib.EUSetOCSPAccessInfoSettings.argtypes = [c_char_p, c_char_p, c_char_p]
    lib.EUSetOCSPAccessInfoSettings.restype = DWORD
    lib.EUSetTSPSettings.argtypes = [BOOL, c_char_p, c_char_p]
    lib.EUSetTSPSettings.restype = DWORD
    lib.EUSetCMPSettings.argtypes = [BOOL, c_char_p, c_char_p, c_char_p]
    lib.EUSetCMPSettings.restype = DWORD
    return lib


def err_desc(lib, code: int) -> str:
    s = lib.EUGetErrorDesc(DWORD(code))
    if not s:
        return f"EU error {code}"
    for enc in ("cp1251", "utf-8"):
        try:
            return s.decode(enc)
        except Exception:
            continue
    return f"EU error {code}"


def cstr(b: bytes | None) -> str:
    if not b:
        return ""
    try:
        return b.decode("utf-8")
    except UnicodeDecodeError:
        return b.decode("cp1251", errors="replace")


def check(lib, code: int, what: str) -> None:
    if code != EU_ERROR_NONE:
        die(f"{what}: {err_desc(lib, code)} ({code})")


def init_lib(lib):
    lib.EUSetUIMode(0)
    if not lib.EUIsInitialized():
        check(lib, lib.EUInitialize(), "EUInitialize")
    # settings below are per run; never persist them over EU.app's
    set_param(lib, "SaveSettings", 0)
    cdir = certs_dir().encode("utf-8")
    check(
        lib,
        lib.EUSetFileStoreSettings(cdir, 0, 1, 0, 0, 0, 1, DWORD(3600)),
        "EUSetFileStoreSettings",
    )


def jks_buffer(data: bytes):
    return (c_ubyte * len(data)).from_buffer_copy(data), len(data)


def list_aliases(lib, data: bytes) -> list[str]:
    buf, n = jks_buffer(data)
    aliases: list[str] = []
    idx = 0
    while idx < 64:
        alias_ptr = c_char_p()
        code = lib.EUEnumJKSPrivateKeys(buf, DWORD(n), DWORD(idx), byref(alias_ptr))
        if code == EU_ERROR_WARNING_END_OF_ENUM:
            break
        check(lib, code, f"EUEnumJKSPrivateKeys[{idx}]")
        if not alias_ptr or not alias_ptr.value:
            break
        aliases.append(alias_ptr.value.decode("utf-8", errors="replace"))
        lib.EUFreeMemory(alias_ptr)
        idx += 1
    return aliases


def load_jks_key(lib, data: bytes, alias: str, password: str) -> EU_CERT_OWNER_INFO:
    buf, n = jks_buffer(data)
    priv = PBYTE()
    priv_len = DWORD(0)
    cert_count = DWORD(0)
    certs = PPBYTE()
    cert_lens = PDWORD()

    check(
        lib,
        lib.EUGetJKSPrivateKey(
            buf,
            DWORD(n),
            alias.encode("utf-8"),
            byref(priv),
            byref(priv_len),
            byref(cert_count),
            byref(certs),
            byref(cert_lens),
        ),
        "EUGetJKSPrivateKey",
    )

    try:
        for i in range(cert_count.value):
            ln = int(cert_lens[i])
            if ln <= 0:
                continue
            check(
                lib,
                lib.EUSaveCertificate(certs[i], DWORD(ln)),
                f"EUSaveCertificate[{i}]",
            )
        info = EU_CERT_OWNER_INFO()
        check(
            lib,
            lib.EUReadPrivateKeyBinary(
                priv, priv_len, password.encode("utf-8"), byref(info)
            ),
            "EUReadPrivateKeyBinary",
        )
        return info
    finally:
        if priv:
            lib.EUFreeMemory(priv)
        if certs and cert_lens:
            lib.EUFreeCertificatesArray(cert_count, certs, cert_lens)


def sign_one(lib, inp: str, out: str, external: bool) -> None:
    check(
        lib,
        lib.EUSignFile(
            os.path.abspath(inp).encode("utf-8"),
            os.path.abspath(out).encode("utf-8"),
            BOOL(1 if external else 0),
        ),
        "EUSignFile",
    )


def set_param(lib, name: str, value: int) -> None:
    v = ctypes.c_int32(value)
    check(
        lib,
        lib.EUSetRuntimeParameter(name.encode(), ctypes.addressof(v), DWORD(4)),
        f"EUSetRuntimeParameter({name})",
    )


def norm_cn(name: str) -> str:
    return re.sub(r"[«»“”„\"]", '"', name).casefold().strip()


def configure_servers(lib, issuer: bytes, level: str) -> None:
    """Point timestamp, OCSP and CMP at the servers CAs.json lists for the issuer."""
    enc = "utf-8"
    try:
        name = issuer.decode("utf-8")
    except UnicodeDecodeError:
        enc, name = "cp1251", issuer.decode("cp1251", errors="replace")
    path = os.path.join(certs_dir(), "CAs.json")
    try:
        with open(path, encoding="utf-8") as f:
            cas = json.load(f)
    except (OSError, ValueError):
        die(f"CA list missing or unreadable: {path} (run chezmoi apply)")
    want = norm_cn(name)
    ca = next((c for c in cas if any(norm_cn(n) == want for n in c.get("issuerCNs", []))), None)
    if not ca or not ca.get("tspAddress"):
        die(f"no timestamp server for issuer {name!r} in {path}")
    if level == "x-long" and not ca.get("ocspAccessPointAddress"):
        die(f"no OCSP server for issuer {name!r} in {path}")

    def b(value, default: str = "") -> bytes:
        return str(value or default).encode(enc, errors="replace")

    check(lib, lib.EUSetModeSettings(0), "EUSetModeSettings")
    check(lib, lib.EUSetOCSPAccessInfoModeSettings(1), "EUSetOCSPAccessInfoModeSettings")
    for c in cas:
        if not c.get("ocspAccessPointAddress"):
            continue
        for n in c.get("issuerCNs", []):
            check(
                lib,
                lib.EUSetOCSPAccessInfoSettings(
                    b(n), b(c["ocspAccessPointAddress"]), b(c.get("ocspAccessPointPort"), "80")
                ),
                "EUSetOCSPAccessInfoSettings",
            )
    if ca.get("ocspAccessPointAddress"):
        check(
            lib,
            lib.EUSetOCSPSettings(
                1, 1, b(ca["ocspAccessPointAddress"]), b(ca.get("ocspAccessPointPort"), "80")
            ),
            "EUSetOCSPSettings",
        )
    check(
        lib,
        lib.EUSetTSPSettings(1, b(ca["tspAddress"]), b(ca.get("tspAddressPort"), "80")),
        "EUSetTSPSettings",
    )
    if ca.get("cmpAddress"):
        check(lib, lib.EUSetCMPSettings(1, b(ca["cmpAddress"]), b"80", b""), "EUSetCMPSettings")


def der_items(b: bytes, i: int = 0, end: int | None = None):
    """Yield (tag, start, end) for each DER element in b[i:end]."""
    end = len(b) if end is None else end
    while i < end:
        tag = b[i]
        ln = b[i + 1]
        i += 2
        if ln == 0x80:
            raise ValueError("indefinite length")
        if ln & 0x80:
            n = ln & 0x7F
            ln = int.from_bytes(b[i:i + n], "big")
            i += n
        if i + ln > end:
            raise ValueError("truncated element")
        yield tag, i, i + ln
        i += ln


def der_children(b: bytes, item) -> list:
    return list(der_items(b, item[1], item[2]))


def oid_str(v: bytes) -> str:
    parts, n = [], 0
    for x in v:
        n = (n << 7) | (x & 0x7F)
        if not x & 0x80:
            parts.append(n)
            n = 0
    head = min(parts[0] // 40, 2)
    return ".".join(map(str, [head, parts[0] - 40 * head, *parts[1:]]))


def der_time(b: bytes, item) -> str:
    text = b[item[1]:item[2]].decode("ascii").rstrip("Z")
    if item[0] == 0x17:
        t = datetime.datetime.strptime(text[:12], "%y%m%d%H%M%S")
    else:
        t = datetime.datetime.strptime(text[:14], "%Y%m%d%H%M%S")
    return f"{t:%Y-%m-%d %H:%M:%S} UTC"


def signed_data(b: bytes, content_info) -> list:
    ci = der_children(b, content_info)
    if oid_str(b[ci[0][1]:ci[0][2]]) != "1.2.840.113549.1.7.2":
        raise ValueError("not CMS signed data")
    return der_children(b, der_children(b, ci[1])[0])


def attributes(b: bytes, item) -> dict:
    out = {}
    for attr in der_children(b, item):
        oid, values = der_children(b, attr)[:2]
        out[oid_str(b[oid[1]:oid[2]])] = der_children(b, values)
    return out


def token_time(b: bytes, token) -> str:
    sd = signed_data(b, token)
    econtent = der_children(b, sd[2])[1]
    octets = der_children(b, econtent)[0]
    tst_info = der_children(b, octets)[0]
    return der_time(b, der_children(b, tst_info)[4])


def cms_summary(b: bytes) -> dict:
    try:
        sd = signed_data(b, next(der_items(b)))
        if sd[-1][0] != 0x31:
            raise ValueError("no signer infos")
        signers = der_children(b, sd[-1])
        if not signers:
            raise ValueError("no signers")
        signed, unsigned = {}, {}
        for part in der_children(b, signers[0]):
            if part[0] == 0xA0:
                signed = attributes(b, part)
            elif part[0] == 0xA1:
                unsigned = attributes(b, part)
        if OID_TIMESTAMP not in unsigned:
            level = "CAdES-BES"
        elif all(o in unsigned for o in OID_REFS + OID_VALUES):
            level = "CAdES-X Long"
        elif all(o in unsigned for o in OID_REFS):
            level = "CAdES-C"
        else:
            level = "CAdES-T"
        return {
            "level": level,
            "attached": len(der_children(b, sd[2])) > 1,
            "signers": len(signers),
            "signing_time": der_time(b, signed[OID_SIGNING_TIME][0]) if OID_SIGNING_TIME in signed else "",
            "timestamp": token_time(b, unsigned[OID_TIMESTAMP][0]) if OID_TIMESTAMP in unsigned else "",
        }
    except (IndexError, StopIteration, ValueError, UnicodeDecodeError) as e:
        raise ValueError(f"not a readable CAdES signature ({e})") from None


def inspect(path: str) -> int:
    try:
        with open(path, "rb") as f:
            s = cms_summary(f.read())
    except OSError as e:
        die(f"cannot read {path}: {e.strerror}")
    except ValueError as e:
        die(f"{path}: {e}")
    print(f"level         {s['level']}")
    print(f"content       {'attached' if s['attached'] else 'detached'}")
    print(f"signers       {s['signers']}")
    if s["signing_time"]:
        print(f"signing time  {s['signing_time']}")
    print(f"timestamp     {s['timestamp'] or 'none'}")
    return 0


def prefer_apple_python() -> None:
    """Re-run under Apple's signed python so firewall rules survive nix updates."""
    if sys.platform != "darwin" or os.environ.get("EUSIGN_REEXEC"):
        return
    try:
        if subprocess.run(["/usr/bin/xcode-select", "-p"], capture_output=True, timeout=10).returncode != 0:
            return
    except (OSError, subprocess.TimeoutExpired):
        return
    os.environ["EUSIGN_REEXEC"] = "1"
    os.execv(APPLE_PYTHON, [APPLE_PYTHON, "-I", os.path.abspath(__file__), *sys.argv[1:]])


def op_run(*args: str) -> subprocess.CompletedProcess:
    try:
        # no inherited stdin: op refuses --template while stdin is a pipe
        return subprocess.run(["op", *args], stdin=subprocess.DEVNULL, capture_output=True, timeout=180)
    except FileNotFoundError:
        die("1Password CLI 'op' not found")
    except subprocess.TimeoutExpired:
        die("1Password CLI timed out; is 1Password unlocked?")


def op(*args: str) -> bytes:
    r = op_run(*args)
    if r.returncode != 0:
        die("op: " + r.stderr.decode("utf-8", "replace").strip())
    return r.stdout


def op_item_args() -> list[str]:
    args = [os.environ.get("EUSIGN_OP_ITEM") or "eusign"]
    if os.environ.get("EUSIGN_OP_VAULT"):
        args += ["--vault", os.environ["EUSIGN_OP_VAULT"]]
    return args


def op_item() -> dict:
    return json.loads(op("item", "get", *op_item_args(), "--format", "json"))


def op_item_or_none() -> dict | None:
    r = op_run("item", "get", *op_item_args(), "--format", "json")
    if r.returncode == 0:
        return json.loads(r.stdout)
    err = r.stderr.decode("utf-8", "replace")
    if "isn't an item" in err:
        return None
    die("op: " + err.strip())


def profile_sections(item: dict) -> dict[str, dict]:
    """Section label -> section, for sections that hold a password field."""
    with_password = {
        (f.get("section") or {}).get("id")
        for f in item.get("fields", [])
        if (f.get("label") or "").lower() == "password"
    }
    return {
        sec["label"]: sec
        for sec in item.get("sections", [])
        if sec.get("label") and sec.get("id") in with_password
    }


def key_from_profile(name: str, need_password: bool) -> tuple[bytes, str, str]:
    item = op_item()
    sections = profile_sections(item)
    if name not in sections:
        have = ", ".join(sorted(sections)) or "none"
        die(f"no profile {name!r} in 1Password item {item.get('title')!r}; have: {have}")
    sid = sections[name]["id"]
    fields = {
        (f.get("label") or "").lower(): f
        for f in item.get("fields", [])
        if (f.get("section") or {}).get("id") == sid
    }

    files = [x for x in item.get("files", []) if (x.get("section") or {}).get("id") == sid]
    if len(files) > 1:
        files = [x for x in files if x.get("name", "").lower().endswith(".jks")]
    if not files:
        files = [
            x for x in item.get("files", [])
            if not (x.get("section") or {}).get("id") and x.get("name") == f"{name}.jks"
        ]
    if len(files) != 1:
        die(f"profile {name!r} needs exactly one attached key store file")
    store = files[0]
    store_sid = (store.get("section") or {}).get("id")
    ref = f"op://{item['vault']['id']}/{item['id']}/" + (f"{store_sid}/" if store_sid else "") + store["id"]
    data = op("read", ref)
    # op read appends a newline to stdout; trust the recorded size, not the tail byte
    size = store.get("size")
    if isinstance(size, int):
        if len(data) == size + 1 and data.endswith(b"\n"):
            data = data[:-1]
        if len(data) != size:
            die(f"profile {name!r}: key store read back {len(data)} bytes, expected {size}")

    password = ""
    if need_password:
        pwf = fields.get("password") or {}
        password = pwf.get("value") or ""
        if not password and pwf.get("reference"):
            password = op("read", pwf["reference"]).decode("utf-8").rstrip("\n")
        if not password:
            die(f"profile {name!r} has an empty password field")
    alias = (fields.get("alias") or {}).get("value") or ""
    return data, password, alias


def key_from_env(need_password: bool) -> tuple[bytes, str, str]:
    jks = os.environ.get("EUSIGN_JKS")
    if not jks:
        die("no key selected: use --key NAME, set EUSIGN_KEY, or set EUSIGN_JKS")
    path = os.path.abspath(os.path.expanduser(jks))
    if not os.path.isfile(path):
        die(f"key store not found: {path}")
    with open(path, "rb") as f:
        data = f.read()
    password = os.environ.get("EUSIGN_JKS_PASSWORD", "")
    if need_password and not password:
        die("EUSIGN_JKS_PASSWORD is not set")
    return data, password, os.environ.get("EUSIGN_ALIAS", "")


def write_private(path: str, data: bytes) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)


def assign_name(text: str) -> str:
    """Escape a section or field name for an op assignment statement."""
    return text.replace("\\", "\\\\").replace(".", "\\.").replace("=", "\\=")


def keystore_certs(lib, data: bytes, alias: str) -> list[bytes]:
    buf, n = jks_buffer(data)
    priv, priv_len, cert_count = PBYTE(), DWORD(0), DWORD(0)
    certs, cert_lens = PPBYTE(), PDWORD()
    check(
        lib,
        lib.EUGetJKSPrivateKey(
            buf, DWORD(n), alias.encode("utf-8"), byref(priv), byref(priv_len),
            byref(cert_count), byref(certs), byref(cert_lens),
        ),
        "EUGetJKSPrivateKey",
    )
    try:
        return [
            ctypes.string_at(certs[i], int(cert_lens[i]))
            for i in range(cert_count.value)
            if int(cert_lens[i]) > 0
        ]
    finally:
        if priv:
            lib.EUFreeMemory(priv)
        if certs and cert_lens:
            lib.EUFreeCertificatesArray(cert_count, certs, cert_lens)


def print_validity(ders: list[bytes]) -> None:
    now = datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)
    for der in ders:
        try:
            r = subprocess.run(
                ["openssl", "x509", "-inform", "der", "-noout", "-enddate", "-text"],
                input=der, capture_output=True, timeout=30,
            )
            text = r.stdout.decode("utf-8", "replace")
        except (FileNotFoundError, subprocess.TimeoutExpired):
            text = ""
        if "CA:TRUE" in text:
            role = "certification authority"
        elif "Digital Signature" in text:
            role = "signing"
        elif "Key Agreement" in text:
            role = "key agreement"
        else:
            role = "certificate"
        found = re.search(r"notAfter=(.+)", text)
        try:
            until = datetime.datetime.strptime(found.group(1).strip(), "%b %d %H:%M:%S %Y %Z")
        except (AttributeError, ValueError):
            print(f"  {role:<24} validity unknown")
            continue
        days = (until - now).days
        note = "  EXPIRED" if days < 0 else ("  renew soon" if days <= 30 else "")
        print(f"  {role:<24} valid until {until:%Y-%m-%d} ({days} days){note}")


def pick_alias(aliases: list[str], preferred: str) -> str:
    if not aliases:
        die("key store has no private-key aliases")
    if preferred:
        if preferred not in aliases:
            die(f"alias {preferred!r} not in key store; have: {aliases}")
        return preferred
    if len(aliases) == 1:
        return aliases[0]
    for i, a in enumerate(aliases, 1):
        print(f"  {i}. {a}", file=sys.stderr)
    choice = input("Key store holds several keys; choose a number: ").strip()
    if not choice.isdigit() or not 1 <= int(choice) <= len(aliases):
        die("no valid key chosen")
    return aliases[int(choice) - 1]


def set_key(name: str, jks_path: str) -> int:
    name = name.strip()
    if not name:
        die("profile name is empty")
    path = os.path.abspath(os.path.expanduser(jks_path))
    if not os.path.isfile(path):
        die(f"key store not found: {path}")
    with open(path, "rb") as f:
        data = f.read()
    password = getpass.getpass(f"Password for {os.path.basename(path)}: ")
    if not password:
        die("empty password")

    # prove the password opens the key before anything is stored
    lib = load_euscp()
    init_lib(lib)
    try:
        aliases = list_aliases(lib, data)
        alias = pick_alias(aliases, os.environ.get("EUSIGN_ALIAS", ""))
        info = load_jks_key(lib, data, alias, password)
        lib.EUFreeCertOwnerInfo(byref(info))
        lib.EUResetPrivateKey()
        ders = keystore_certs(lib, data, alias)
    finally:
        if lib.EUIsInitialized():
            lib.EUFinalize()
    print("key opens with this password")

    section = assign_name(name)
    item = op_item_or_none()
    tmpdir = tempfile.mkdtemp()
    os.chmod(tmpdir, 0o700)
    try:
        store = os.path.join(tmpdir, "keystore")
        template = os.path.join(tmpdir, "item.json")
        write_private(store, data)
        if item is None:
            vault = os.environ.get("EUSIGN_OP_VAULT")
            if not vault:
                die("no 1Password item yet; set EUSIGN_OP_VAULT to the vault that should hold it")
            tpl = json.loads(op("item", "template", "get", "Secure Note"))
            tpl["title"] = os.environ.get("EUSIGN_OP_ITEM") or "eusign"
            tpl["tags"] = ["eusign"]
            tpl["sections"] = [{"id": "key1", "label": name}]
            tpl["fields"] = [f for f in tpl.get("fields", []) if f.get("purpose") == "NOTES"]
            tpl["fields"].append({"id": "key1password", "section": {"id": "key1"},
                                  "type": "CONCEALED", "label": "password", "value": password})
            if len(aliases) > 1:
                tpl["fields"].append({"id": "key1alias", "section": {"id": "key1"},
                                      "type": "STRING", "label": "alias", "value": alias})
            write_private(template, json.dumps(tpl).encode())
            op("item", "create", "--vault", vault, "--template", template,
               f"{section}.keystore[file]={store}")
        else:
            vault_id, item_id = item["vault"]["id"], item["id"]
            sec = next((x for x in item.get("sections", []) if x.get("label") == name), None)
            if sec is None:
                sid = "key" + secrets.token_hex(4)
                item.setdefault("sections", []).append({"id": sid, "label": name})
            else:
                sid = sec["id"]
                stale = [
                    f["name"] for f in item.get("files", [])
                    if (f.get("section") or {}).get("id") == sid and f.get("name") != "keystore"
                ]
                if stale:
                    op("item", "edit", item_id, "--vault", vault_id,
                       *[f"{section}.{assign_name(n)}[delete]" for n in stale])
                    item = json.loads(op("item", "get", item_id, "--vault", vault_id, "--format", "json"))
            fields = item.setdefault("fields", [])

            def upsert(label: str, ftype: str, value: str) -> None:
                for f in fields:
                    if (f.get("section") or {}).get("id") == sid and (f.get("label") or "").lower() == label:
                        f["type"], f["value"] = ftype, value
                        return
                fields.append({"id": f"{sid}{label}", "section": {"id": sid},
                               "type": ftype, "label": label, "value": value})

            upsert("password", "CONCEALED", password)
            has_alias = any((f.get("section") or {}).get("id") == sid and (f.get("label") or "").lower() == "alias"
                            for f in fields)
            if len(aliases) > 1 or has_alias:
                upsert("alias", "STRING", alias)
            write_private(template, json.dumps(item).encode())
            op("item", "edit", item_id, "--vault", vault_id, "--template", template,
               f"{section}.keystore[file]={store}")
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

    stored, stored_password, _ = key_from_profile(name, need_password=True)
    if stored != data or stored_password != password:
        die("the copy in 1Password does not match; check the item before signing")
    print(f"stored profile {name!r} in 1Password and verified the stored copy")
    print_validity(ders)
    return 0


def delete_key(name: str) -> int:
    item = op_item()
    sec = next((x for x in item.get("sections", []) if x.get("label") == name), None)
    if sec is None:
        die(f"no profile {name!r} in 1Password item {item.get('title')!r}")
    sid = sec["id"]
    labels = [f["label"] for f in item.get("fields", [])
              if (f.get("section") or {}).get("id") == sid and f.get("label")]
    labels += [f["name"] for f in item.get("files", [])
               if (f.get("section") or {}).get("id") == sid and f.get("name")]
    if input(f"Type {name} to delete this key from 1Password: ").strip() != name:
        die("not confirmed; nothing deleted")
    section = assign_name(name)
    op("item", "edit", item["id"], "--vault", item["vault"]["id"],
       *[f"{section}.{assign_name(label)}[delete]" for label in labels])
    if name in profile_sections(op_item()):
        die("profile is still present after the delete")
    print(f"deleted profile {name!r}")
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="sign-file",
        description="Sign a file to CAdES .p7s via ІІТ EUSignCP and a JKS key store",
    )
    p.add_argument("--key", metavar="NAME", help="Profile: a section of the 1Password item (default: $EUSIGN_KEY)")
    p.add_argument("--keys", action="store_true", help="List profiles in the 1Password item")
    p.add_argument("--list", action="store_true", help="List key aliases in the key store")
    p.add_argument("--check", action="store_true", help="Confirm the password opens the key; sign nothing")
    p.add_argument("--info", action="store_true", help="Show certificate validity; no password needed")
    p.add_argument("--set-key", nargs=2, metavar=("NAME", "JKS"), help="Add or renew a profile in 1Password")
    p.add_argument("--delete-key", metavar="NAME", help="Remove a profile from 1Password")
    p.add_argument(
        "--attached",
        action="store_true",
        help="Attached CAdES (data embedded) instead of detached",
    )
    p.add_argument("--level", choices=list(LEVELS), default="x-long",
                   help="CAdES level (default: x-long)")
    p.add_argument("--inspect", metavar="P7S", help="Report a signature's level; no key needed")
    p.add_argument("input", nargs="?", help="Input file to sign")
    p.add_argument("output", nargs="?", help="Output .p7s (default: <input>.p7s)")
    args = p.parse_args(argv)

    if args.inspect:
        return inspect(os.path.expanduser(args.inspect))
    if args.set_key:
        return set_key(*args.set_key)
    if args.delete_key:
        return delete_key(args.delete_key)

    if args.keys:
        for label in sorted(profile_sections(op_item())):
            print(label)
        return 0

    signing = not (args.list or args.check or args.info)
    inp = out = ""
    if signing:
        if not args.input:
            p.print_help()
            return 2
        # load_euscp() changes the working directory, so resolve user paths first
        inp = os.path.abspath(os.path.expanduser(args.input))
        if not os.path.isfile(inp):
            die(f"input not found: {args.input}")
        out = (
            os.path.abspath(os.path.expanduser(args.output))
            if args.output
            else inp + ".p7s"
        )

    name = args.key or os.environ.get("EUSIGN_KEY", "")
    need_password = not (args.list or args.info)
    if name:
        data, password, alias = key_from_profile(name, need_password)
    else:
        data, password, alias = key_from_env(need_password)

    lib = load_euscp()
    init_lib(lib)

    try:
        aliases = list_aliases(lib, data)
        if args.info:
            for a in ([alias] if alias else aliases):
                print(f"{a}:")
                print_validity(keystore_certs(lib, data, a))
            return 0

        if args.list:
            if not aliases:
                print("(no aliases found)")
            for a in aliases:
                print(f"{a}{' *' if a == alias else ''}")
            return 0

        if not aliases:
            die("key store has no private-key aliases")
        if alias:
            if alias not in aliases:
                die(f"alias {alias!r} not in key store; have: {aliases}")
        elif len(aliases) > 1:
            die("several aliases in key store; set the profile's alias field "
                "or EUSIGN_ALIAS to one of: " + ", ".join(aliases))
        else:
            alias = aliases[0]

        info = load_jks_key(lib, data, alias, password)
        try:
            subj = cstr(info.pszSubjCN)
            who = f" cn={subj!r}" if subj else ""
            print(f"sign-file: using alias={alias!r}{who}", file=sys.stderr)
            if args.check:
                print("key opens with the stored password; nothing signed")
                return 0
            if args.level != "bes":
                configure_servers(lib, info.pszIssuerCN or b"", args.level)
            set_param(lib, "SignType", LEVELS[args.level])
            sign_one(lib, inp, out, not args.attached)
        finally:
            lib.EUFreeCertOwnerInfo(byref(info))
            lib.EUResetPrivateKey()

        try:
            with open(out, "rb") as f:
                got = cms_summary(f.read())["level"]
        except (OSError, ValueError) as e:
            die(f"cannot read back {out}: {e}")
        want = WANTED[args.level]
        if LEVEL_NAMES.index(got) < LEVEL_NAMES.index(want):
            die(f"{out} is {got}, not {want}; do not upload it")
        mode = "attached" if args.attached else "detached"
        print(f"wrote {out} ({mode} {got})")
        return 0
    finally:
        if lib.EUIsInitialized():
            lib.EUFinalize()


if __name__ == "__main__":
    prefer_apple_python()
    raise SystemExit(main())
