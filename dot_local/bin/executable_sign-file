#!/usr/bin/env python3
"""sign-file — CAdES (.p7s) signatures via ІІТ EUSignCP (euscp.dylib) and JKS key stores.

Keys come from one 1Password item, or from environment variables.

The 1Password item (title `eusign` by default) holds one section per key. The
section name is the profile name. Each section has a `password` field, the key
store attached as a file, and optionally an `alias` field. A key store may also
be attached to the item itself as `<profile>.jks`.

Env:
  EUSIGN_KEY           default profile (same as --key)
  EUSIGN_OP_ITEM       1Password item title (default: eusign)
  EUSIGN_OP_VAULT      1Password vault, if the title is not unique
  EUSIGN_JKS           key store path, used when no profile is selected
  EUSIGN_JKS_PASSWORD  its password (env only, never argv)
  EUSIGN_ALIAS         its key alias (required if the store holds several keys)
  EUSIGN_LIB_DIR       library dir (default: ~/opt/eusign/lib)
  EUSIGN_CERTS_DIR     certificate file store (default: ~/opt/eusign/certs)

Usage:
  sign-file --keys                              list profiles
  sign-file [--key NAME] --list                 list aliases in the key store
  sign-file [--key NAME] --check                confirm the password opens the key
  sign-file [--key NAME] <input> [output.p7s]
  sign-file [--key NAME] --attached <input> [output.p7s]

Default is a detached signature (.p7s beside the original); --attached embeds
the data in the .p7s.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import ctypes
from ctypes import (
    POINTER,
    Structure,
    byref,
    c_char_p,
    c_int,
    c_ubyte,
    c_ulong,
    c_void_p,
)

EU_ERROR_NONE = 0
EU_ERROR_WARNING_END_OF_ENUM = 7
BOOL = c_int
DWORD = c_ulong  # ІІТ's DWORD is unsigned long: 8 bytes on macOS
PBYTE = POINTER(c_ubyte)
PPBYTE = POINTER(PBYTE)
PDWORD = POINTER(DWORD)
PPDWORD = POINTER(PDWORD)


class EU_CERT_OWNER_INFO(Structure):
    _pack_ = 1  # ІІТ packs this struct: the pointers start at byte 4
    _layout_ = "ms"
    _fields_ = [
        ("bFilled", BOOL),
        ("pszIssuer", c_char_p),
        ("pszIssuerCN", c_char_p),
        ("pszSerial", c_char_p),
        ("pszSubject", c_char_p),
        ("pszSubjCN", c_char_p),
        ("pszSubjOrg", c_char_p),
        ("pszSubjOrgUnit", c_char_p),
        ("pszSubjTitle", c_char_p),
        ("pszSubjState", c_char_p),
        ("pszSubjLocality", c_char_p),
        ("pszSubjFullName", c_char_p),
        ("pszSubjAddress", c_char_p),
        ("pszSubjPhone", c_char_p),
        ("pszSubjEMail", c_char_p),
        ("pszSubjDNS", c_char_p),
        ("pszSubjEDRPOUCode", c_char_p),
        ("pszSubjDRFOCode", c_char_p),
    ]


def die(msg: str, code: int = 1) -> None:
    print(f"sign-file: {msg}", file=sys.stderr)
    raise SystemExit(code)


def lib_dir() -> str:
    d = os.environ.get("EUSIGN_LIB_DIR") or os.path.expanduser("~/opt/eusign/lib")
    if not os.path.isdir(d):
        die(f"EUSign lib dir missing: {d} (run chezmoi eusign install hook)")
    return d


def certs_dir() -> str:
    d = os.environ.get("EUSIGN_CERTS_DIR") or os.path.expanduser("~/opt/eusign/certs")
    os.makedirs(d, exist_ok=True)
    return d


def load_euscp():
    d = lib_dir()
    # Stay in lib dir so @loader_path / sibling km.*.dylib resolve (SIP-safe).
    os.chdir(d)
    try:
        lib = ctypes.CDLL(os.path.join(d, "euscp.dylib"))
    except OSError as e:
        die(f"failed to load euscp.dylib from {d}: {e}")

    lib.EUSetUIMode.argtypes = [BOOL]
    lib.EUSetUIMode.restype = None
    lib.EUInitialize.argtypes = []
    lib.EUInitialize.restype = DWORD
    lib.EUIsInitialized.argtypes = []
    lib.EUIsInitialized.restype = BOOL
    lib.EUFinalize.argtypes = []
    lib.EUFinalize.restype = DWORD
    lib.EUGetErrorDesc.argtypes = [DWORD]
    lib.EUGetErrorDesc.restype = c_char_p

    lib.EUSetFileStoreSettings.argtypes = [
        c_char_p, BOOL, BOOL, BOOL, BOOL, BOOL, BOOL, DWORD
    ]
    lib.EUSetFileStoreSettings.restype = DWORD

    # Prefer in-memory JKS APIs — File* variants fail on emoji/iCloud paths.
    lib.EUEnumJKSPrivateKeys.argtypes = [PBYTE, DWORD, DWORD, POINTER(c_char_p)]
    lib.EUEnumJKSPrivateKeys.restype = DWORD

    # Order per IIT NIXes CPP appendix:
    #   priv, privLen, certsCount, certs**, certLens**
    lib.EUGetJKSPrivateKey.argtypes = [
        PBYTE,
        DWORD,
        c_char_p,
        POINTER(PBYTE),
        PDWORD,
        PDWORD,
        POINTER(PPBYTE),
        POINTER(PDWORD),
    ]
    lib.EUGetJKSPrivateKey.restype = DWORD

    lib.EUFreeMemory.argtypes = [c_void_p]
    lib.EUFreeMemory.restype = DWORD
    # count first: the other order aborts the process
    lib.EUFreeCertificatesArray.argtypes = [DWORD, PPBYTE, PDWORD]
    lib.EUFreeCertificatesArray.restype = None
    lib.EUSaveCertificate.argtypes = [PBYTE, DWORD]
    lib.EUSaveCertificate.restype = DWORD
    lib.EUReadPrivateKeyBinary.argtypes = [
        PBYTE, DWORD, c_char_p, POINTER(EU_CERT_OWNER_INFO)
    ]
    lib.EUReadPrivateKeyBinary.restype = DWORD
    lib.EUFreeCertOwnerInfo.argtypes = [POINTER(EU_CERT_OWNER_INFO)]
    lib.EUFreeCertOwnerInfo.restype = DWORD
    lib.EUResetPrivateKey.argtypes = []
    lib.EUResetPrivateKey.restype = None
    lib.EUSignFile.argtypes = [c_char_p, c_char_p, BOOL]
    lib.EUSignFile.restype = DWORD
    return lib


def err_desc(lib, code: int) -> str:
    s = lib.EUGetErrorDesc(DWORD(code))
    if not s:
        return f"EU error {code}"
    for enc in ("cp1251", "utf-8"):
        try:
            return s.decode(enc)
        except Exception:
            continue
    return f"EU error {code}"


def cstr(b: bytes | None) -> str:
    if not b:
        return ""
    try:
        return b.decode("utf-8")
    except UnicodeDecodeError:
        return b.decode("cp1251", errors="replace")


def check(lib, code: int, what: str) -> None:
    if code != EU_ERROR_NONE:
        die(f"{what}: {err_desc(lib, code)} ({code})")


def init_lib(lib):
    lib.EUSetUIMode(0)
    if not lib.EUIsInitialized():
        check(lib, lib.EUInitialize(), "EUInitialize")
    cdir = certs_dir().encode("utf-8")
    check(
        lib,
        lib.EUSetFileStoreSettings(cdir, 0, 1, 0, 0, 0, 1, DWORD(3600)),
        "EUSetFileStoreSettings",
    )


def jks_buffer(data: bytes):
    return (c_ubyte * len(data)).from_buffer_copy(data), len(data)


def list_aliases(lib, data: bytes) -> list[str]:
    buf, n = jks_buffer(data)
    aliases: list[str] = []
    idx = 0
    while idx < 64:
        alias_ptr = c_char_p()
        code = lib.EUEnumJKSPrivateKeys(buf, DWORD(n), DWORD(idx), byref(alias_ptr))
        if code == EU_ERROR_WARNING_END_OF_ENUM:
            break
        check(lib, code, f"EUEnumJKSPrivateKeys[{idx}]")
        if not alias_ptr or not alias_ptr.value:
            break
        aliases.append(alias_ptr.value.decode("utf-8", errors="replace"))
        lib.EUFreeMemory(alias_ptr)
        idx += 1
    return aliases


def load_jks_key(lib, data: bytes, alias: str, password: str) -> EU_CERT_OWNER_INFO:
    buf, n = jks_buffer(data)
    priv = PBYTE()
    priv_len = DWORD(0)
    cert_count = DWORD(0)
    certs = PPBYTE()
    cert_lens = PDWORD()

    check(
        lib,
        lib.EUGetJKSPrivateKey(
            buf,
            DWORD(n),
            alias.encode("utf-8"),
            byref(priv),
            byref(priv_len),
            byref(cert_count),
            byref(certs),
            byref(cert_lens),
        ),
        "EUGetJKSPrivateKey",
    )

    try:
        for i in range(cert_count.value):
            ln = int(cert_lens[i])
            if ln <= 0:
                continue
            check(
                lib,
                lib.EUSaveCertificate(certs[i], DWORD(ln)),
                f"EUSaveCertificate[{i}]",
            )
        info = EU_CERT_OWNER_INFO()
        check(
            lib,
            lib.EUReadPrivateKeyBinary(
                priv, priv_len, password.encode("utf-8"), byref(info)
            ),
            "EUReadPrivateKeyBinary",
        )
        return info
    finally:
        if priv:
            lib.EUFreeMemory(priv)
        if certs and cert_lens:
            lib.EUFreeCertificatesArray(cert_count, certs, cert_lens)


def sign_one(lib, inp: str, out: str, external: bool) -> None:
    check(
        lib,
        lib.EUSignFile(
            os.path.abspath(inp).encode("utf-8"),
            os.path.abspath(out).encode("utf-8"),
            BOOL(1 if external else 0),
        ),
        "EUSignFile",
    )


def op(*args: str) -> bytes:
    try:
        r = subprocess.run(["op", *args], capture_output=True, timeout=120)
    except FileNotFoundError:
        die("1Password CLI 'op' not found")
    except subprocess.TimeoutExpired:
        die("1Password CLI timed out; is 1Password unlocked?")
    if r.returncode != 0:
        die("op: " + r.stderr.decode("utf-8", "replace").strip())
    return r.stdout


def op_item() -> dict:
    cmd = ["item", "get", os.environ.get("EUSIGN_OP_ITEM") or "eusign", "--format", "json"]
    if os.environ.get("EUSIGN_OP_VAULT"):
        cmd += ["--vault", os.environ["EUSIGN_OP_VAULT"]]
    return json.loads(op(*cmd))


def profile_sections(item: dict) -> dict[str, dict]:
    """Section label -> section, for sections that hold a password field."""
    with_password = {
        (f.get("section") or {}).get("id")
        for f in item.get("fields", [])
        if (f.get("label") or "").lower() == "password"
    }
    return {
        sec["label"]: sec
        for sec in item.get("sections", [])
        if sec.get("label") and sec.get("id") in with_password
    }


def key_from_profile(name: str, need_password: bool) -> tuple[bytes, str, str]:
    item = op_item()
    sections = profile_sections(item)
    if name not in sections:
        have = ", ".join(sorted(sections)) or "none"
        die(f"no profile {name!r} in 1Password item {item.get('title')!r}; have: {have}")
    sid = sections[name]["id"]
    fields = {
        (f.get("label") or "").lower(): f
        for f in item.get("fields", [])
        if (f.get("section") or {}).get("id") == sid
    }

    files = [x for x in item.get("files", []) if (x.get("section") or {}).get("id") == sid]
    if len(files) > 1:
        files = [x for x in files if x.get("name", "").lower().endswith(".jks")]
    if not files:
        files = [
            x for x in item.get("files", [])
            if not (x.get("section") or {}).get("id") and x.get("name") == f"{name}.jks"
        ]
    if len(files) != 1:
        die(f"profile {name!r} needs exactly one attached key store file")
    store = files[0]
    store_sid = (store.get("section") or {}).get("id")
    ref = f"op://{item['vault']['id']}/{item['id']}/" + (f"{store_sid}/" if store_sid else "") + store["id"]
    data = op("read", ref)
    # op read appends a newline to stdout; trust the recorded size, not the tail byte
    size = store.get("size")
    if isinstance(size, int):
        if len(data) == size + 1 and data.endswith(b"\n"):
            data = data[:-1]
        if len(data) != size:
            die(f"profile {name!r}: key store read back {len(data)} bytes, expected {size}")

    password = ""
    if need_password:
        pwf = fields.get("password") or {}
        password = pwf.get("value") or ""
        if not password and pwf.get("reference"):
            password = op("read", pwf["reference"]).decode("utf-8").rstrip("\n")
        if not password:
            die(f"profile {name!r} has an empty password field")
    alias = (fields.get("alias") or {}).get("value") or ""
    return data, password, alias


def key_from_env(need_password: bool) -> tuple[bytes, str, str]:
    jks = os.environ.get("EUSIGN_JKS")
    if not jks:
        die("no key selected: use --key NAME, set EUSIGN_KEY, or set EUSIGN_JKS")
    path = os.path.abspath(os.path.expanduser(jks))
    if not os.path.isfile(path):
        die(f"key store not found: {path}")
    with open(path, "rb") as f:
        data = f.read()
    password = os.environ.get("EUSIGN_JKS_PASSWORD", "")
    if need_password and not password:
        die("EUSIGN_JKS_PASSWORD is not set")
    return data, password, os.environ.get("EUSIGN_ALIAS", "")


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="sign-file",
        description="Sign a file to CAdES .p7s via ІІТ EUSignCP and a JKS key store",
    )
    p.add_argument("--key", metavar="NAME", help="Profile: a section of the 1Password item (default: $EUSIGN_KEY)")
    p.add_argument("--keys", action="store_true", help="List profiles in the 1Password item")
    p.add_argument("--list", action="store_true", help="List key aliases in the key store")
    p.add_argument("--check", action="store_true", help="Confirm the password opens the key; sign nothing")
    p.add_argument(
        "--attached",
        action="store_true",
        help="Attached CAdES (data embedded) instead of detached",
    )
    p.add_argument("input", nargs="?", help="Input file to sign")
    p.add_argument("output", nargs="?", help="Output .p7s (default: <input>.p7s)")
    args = p.parse_args(argv)

    if args.keys:
        for label in sorted(profile_sections(op_item())):
            print(label)
        return 0

    signing = not (args.list or args.check)
    inp = out = ""
    if signing:
        if not args.input:
            p.print_help()
            return 2
        # load_euscp() changes the working directory, so resolve user paths first
        inp = os.path.abspath(os.path.expanduser(args.input))
        if not os.path.isfile(inp):
            die(f"input not found: {args.input}")
        out = (
            os.path.abspath(os.path.expanduser(args.output))
            if args.output
            else inp + ".p7s"
        )

    name = args.key or os.environ.get("EUSIGN_KEY", "")
    need_password = not args.list
    if name:
        data, password, alias = key_from_profile(name, need_password)
    else:
        data, password, alias = key_from_env(need_password)

    lib = load_euscp()
    init_lib(lib)

    try:
        aliases = list_aliases(lib, data)
        if args.list:
            if not aliases:
                print("(no aliases found)")
            for a in aliases:
                print(f"{a}{' *' if a == alias else ''}")
            return 0

        if not aliases:
            die("key store has no private-key aliases")
        if alias:
            if alias not in aliases:
                die(f"alias {alias!r} not in key store; have: {aliases}")
        elif len(aliases) > 1:
            die("several aliases in key store; set the profile's alias field "
                "or EUSIGN_ALIAS to one of: " + ", ".join(aliases))
        else:
            alias = aliases[0]

        info = load_jks_key(lib, data, alias, password)
        try:
            subj = cstr(info.pszSubjCN)
            who = f" cn={subj!r}" if subj else ""
            print(f"sign-file: using alias={alias!r}{who}", file=sys.stderr)
            if args.check:
                print("key opens with the stored password; nothing signed")
                return 0
            sign_one(lib, inp, out, not args.attached)
        finally:
            lib.EUFreeCertOwnerInfo(byref(info))
            lib.EUResetPrivateKey()

        mode = "attached" if args.attached else "detached"
        print(f"wrote {out} ({mode} CAdES)")
        return 0
    finally:
        if lib.EUIsInitialized():
            lib.EUFinalize()


if __name__ == "__main__":
    raise SystemExit(main())
