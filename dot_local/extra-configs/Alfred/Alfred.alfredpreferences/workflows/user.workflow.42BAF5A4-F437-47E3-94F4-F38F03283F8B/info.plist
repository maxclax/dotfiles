				<key>script</key>
				<string># Keyword passes the typed text; the hotkey passes the selection.
INPUT="$1"
if [ -z "$INPUT" ]; then
  # Nothing selected: reopen Alfred prefilled, so one key does both.
  osascript -e 'tell application id "com.runningwithcrayons.Alfred" to search "i "'
  exit 0
fi
# Alfred runs non-interactively, so PATH may lack ~/.config/shell/bin.
if command -v inbox &gt;/dev/null 2&gt;&amp;1; then
  OUT=$(inbox "$INPUT") || exit 1
else
  OUT=$("$HOME/.config/shell/bin/inbox" "$INPUT") || exit 1
fi
printf %s "$OUT"
</string>
