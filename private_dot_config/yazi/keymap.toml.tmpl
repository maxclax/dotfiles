# -*- mode: conf-toml; -*-
#:schema https://yazi-rs.github.io/schemas/keymap.json

# Emacs-style navigation. prepend_keymap overrides defaults; everything
# not listed here keeps the stock binding (see `~` for help).

[mgr]
prepend_keymap = [
	# --- Movement ---
	{ on = "<C-p>", run = "arrow prev",  desc = "Previous file" },
	{ on = "<C-n>", run = "arrow next",  desc = "Next file" },
	{ on = "<C-v>", run = "arrow 100%",  desc = "Page down" },
	{ on = "<A-v>", run = "arrow -100%", desc = "Page up" },
	{ on = "<A-<>", run = "arrow top",   desc = "Go to top" },
	{ on = "<A->>", run = "arrow bot",   desc = "Go to bottom" },
	{ on = "<C-b>", run = "leave",       desc = "Parent directory" },
	{ on = "<C-f>", run = "enter",       desc = "Enter directory" },
	{ on = "<A-b>", run = "back",        desc = "History back" },
	{ on = "<A-f>", run = "forward",     desc = "History forward" },
	{ on = "<C-g>", run = "escape",      desc = "Cancel" },

	# --- Kill-ring style copy/cut/paste ---
	{ on = "<A-w>", run = "yank",       desc = "Copy selected (M-w)" },
	{ on = "<C-w>", run = "yank --cut", desc = "Cut selected (C-w)" },
	{ on = "<C-y>", run = "paste",      desc = "Paste (C-y)" },

	# --- isearch ---
	{ on = "<C-s>", run = "find --smart",            desc = "Find next (C-s)" },
	{ on = "<C-r>", run = "find --previous --smart", desc = "Find previous (C-r)" },

	# --- Quit ---
	{ on = [ "<C-x>", "<C-c>" ], run = "quit", desc = "Quit (C-x C-c)" },

	# --- smart-enter: open file or enter directory with one key ---
	{ on = "<Enter>", run = "plugin smart-enter", desc = "Enter directory or open file" },
	{ on = "l",       run = "plugin smart-enter", desc = "Enter directory or open file" },
{{- if eq .chezmoi.os "darwin" }}

	# --- macOS integration ---
	{ on = "<C-o>", run = 'shell -- open -R "$@"',                desc = "Reveal in Finder (drag out from there)" },
	{ on = "<A-y>", run = 'shell -- open -a Yoink "$@"',          desc = "Put files on Yoink shelf (drag-and-drop)" },
	{ on = "<C-t>", run = 'shell --orphan -- qlmanage -p "$@"',   desc = "Quick Look preview" },
{{- end }}
]

[input]
prepend_keymap = [
	{ on = "<C-g>",         run = "close",         desc = "Cancel input (C-g)" },
	{ on = "<A-Backspace>", run = "kill backward", desc = "Kill word backward (M-DEL)" },
]

