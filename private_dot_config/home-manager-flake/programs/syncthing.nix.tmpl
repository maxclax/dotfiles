# -*- mode: nix; -*-
{ config, pkgs, lib, ... }:

{
{{- if eq .chezmoi.os "darwin" }}
  # Syncthing.app comes from the brew cask (signed, so Little Snitch rules
  # survive updates). Autostart per machine via the chezmoi prompt.
  launchd.agents.syncthing-app = {
    enable = {{ if .syncthingAutostart }}true{{ else }}false{{ end }};
    config = {
      ProgramArguments = [ "/usr/bin/open" "-a" "Syncthing" ];
      RunAtLoad = true;
    };
  };
{{- else }}
  services.syncthing = {
    enable = {{ if .syncthingAutostart }}true{{ else }}false{{ end }};
    extraOptions = [
      "--no-browser"  # Don't open browser on startup
      "--logflags=0"  # Reduce log verbosity
    ];
  };
{{- end }}
}
