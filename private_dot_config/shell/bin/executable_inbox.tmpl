#!/usr/bin/env sh
# Capture text to the org inbox from anywhere — Alfred, Shortcuts, a terminal.
#
# Appends straight to inbox.org. Safe here because nothing else writes it while
# this runs, and Emacs has global-auto-revert-mode, so an open buffer refreshes
# instead of overwriting.
#
# Usage: inbox buy filters        |  pbpaste | inbox  |  inbox < file
set -eu

INBOX={{ .org_dir | quote }}/inbox.org

if [ "$#" -gt 0 ]; then
  TEXT="$*"
else
  TEXT=$(cat)
fi

# Collapse newlines: an org heading is one line.
TEXT=$(printf '%s' "$TEXT" | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')
[ -n "$TEXT" ] || { echo "inbox: nothing to capture" >&2; exit 1; }

if [ -s "$INBOX" ]; then
  # $(tail -c1) is empty when the last byte is a newline
  [ -n "$(tail -c1 "$INBOX")" ] && printf '\n' >> "$INBOX"
  # one blank line between entries, never stacked
  [ -n "$(tail -n1 "$INBOX")" ] && printf '\n' >> "$INBOX"
fi
printf '* TODO %s\n' "$TEXT" >> "$INBOX"
echo "$TEXT"
