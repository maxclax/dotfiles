# ./.tmuxinator.yml
# convert to bash = `tmuxinator debug development`

name: main
root: ~

# You can set tmuxinator to skip auto-attaching to the session by using the attach option.
attach: true

windows:
  - main:
      # even-horizontal, even-vertical, main-horizontal, main-vertical, or tiled.
      layout: ac40,172x55,0,0[172x33,0,0{85x33,0,0,1,86x33,86,0,4},172x21,0,34,5]
      panes:
        - clear
        - lp
        # wait for THIS pane to be focused: yazi probes the terminal and tmux
        # gives the replies to the focused pane — starting it in a background
        # pane times out and sprays escape codes wherever you are typing
        - while [ "$(tmux display -p -t "$TMUX_PANE" '#{pane_active}')" != 1 ]; do sleep 0.5; done; YAZI_SINGLE=1 yazi ~
  - dotfiles:
      layout: tiled
      panes:
        - cd {{ .chezmoi.sourceDir }}
  - playground:
      layout: tiled
      panes:
        - cd {{ .playground }}
