# ./.tmuxinator.yml
# convert to bash = `tmuxinator debug main`
#
# Pane badges: t.("name", "cmd") labels the pane, pre_window styles the border.
# Keep `#{...}` out of the Ruby strings below — ERB would interpolate it.
# <% t = ->(n, c) { %{tmux set-option -qp -t "$TMUX_PANE" @name "#{n}" ; clear ; #{c}} } %>

name: main
root: ~

# You can set tmuxinator to skip auto-attaching to the session by using the attach option.
attach: true

# Named badge on every pane border: dark text on cyan when active, grey otherwise
pre_window: "tmux set-option -qw -t $TMUX_PANE pane-border-status top ; tmux set-option -qw -t $TMUX_PANE pane-border-format '#[fg=colour232,bold]#{?pane_active,#[bg=colour45],#[bg=colour245]} #P #{@name} #[default]'"

windows:
  - main:
      # even-horizontal, even-vertical, main-horizontal, main-vertical, or tiled.
      layout: ac40,172x55,0,0[172x33,0,0{85x33,0,0,1,86x33,86,0,4},172x21,0,34,5]
      panes:
        - <%= t.("shell", "clear") %>
        - <%= t.("lazypodman", "lp") %>
        - <%= t.("ranger", "ranger ~") %>
  - dotfiles:
      layout: tiled
      panes:
        - <%= t.("chezmoi", "cd {{ .chezmoi.sourceDir }}") %>
  - playground:
      layout: tiled
      panes:
        - <%= t.("playground", "cd {{ .playground }}") %>
