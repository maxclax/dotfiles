;;; init-copilot.el -*- mode: emacs-lisp; lexical-binding: t; -*-

(set-evil-initial-state!
  '(comint-mode)
  'insert)

(add-hook! 'comint-mode-hook #'visual-line-mode)

(use-package! copilot
              :commands (copilot-mode)
              :config
              (setq copilot-max-char 3000000)
              (setq copilot-idle-delay 1)

              (add-to-list 'copilot-indentation-alist '(web-mode 2))
              (add-to-list 'copilot-indentation-alist '(html-mode 2))
              (add-to-list 'copilot-indentation-alist '(markdown-mode 2))
              (add-to-list 'copilot-indentation-alist '(prog-mode 2))
              (add-to-list 'copilot-indentation-alist '(org-mode 2))
              (add-to-list 'copilot-indentation-alist '(text-mode 2))
              (add-to-list 'copilot-indentation-alist '(closure-mode 2))
              (add-to-list 'copilot-indentation-alist '(emacs-lisp-mode 2)))

;; Auto-enable copilot for code under the workspace tree and the chezmoi
;; source (dotfiles) — keeps it out of notes and random files elsewhere
(defun my/copilot-path-allowed-p (path)
  (let ((path (expand-file-name path)))
    (or (string-prefix-p (expand-file-name {{ .workspace | quote }}) path)
        (string-prefix-p (expand-file-name {{ .chezmoi.sourceDir | quote }}) path))))

(defun my/copilot-maybe-enable-h ()
  (when (and buffer-file-name
             (my/copilot-path-allowed-p buffer-file-name))
    (copilot-mode 1)))
(add-hook 'prog-mode-hook #'my/copilot-maybe-enable-h)
(add-hook 'conf-mode-hook #'my/copilot-maybe-enable-h)

;; Magit commit buffers are text-mode, so the hooks above never fire there.
;; Same workspace gate: commit messages in workspace projects get copilot.
(defun my/copilot-commit-enable-h ()
  (when (my/copilot-path-allowed-p default-directory)
    (copilot-mode 1)))
(add-hook 'git-commit-setup-hook #'my/copilot-commit-enable-h)

(provide 'init-copilot)
