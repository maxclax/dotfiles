;;; init-gptel.el -*- mode: emacs-lisp; lexical-binding: t; -*-
;; API keys resolve via auth-source (see init-auth.el): 1Password first,
;; ~/.authinfo as fallback.

(use-package! gptel
  ;; `gptel-abort' has no autoload cookie upstream, unlike the other commands
  ;; bound under `C-c C-a' — without it here the key errors until gptel loads.
  :commands (gptel-rewrite gptel-menu gptel-send gptel-abort)
  :config
  ;; Anthropic Claude — key via auth-source (host api.anthropic.com).
  ;; Registered but not default: switch to it with `C-c C-m' in the gptel
  ;; transient, or per-buffer with `gptel-menu'.
  (gptel-make-anthropic "Claude"
    :stream t
    :key #'gptel-api-key-from-auth-source
    :models '(claude-opus-4-8 claude-sonnet-5 claude-haiku-4-5))

  ;; llama.cpp router — the DEFAULT backend, so a stray `gptel-send' costs
  ;; nothing and leaks nothing. Port and models come from
  ;; ~/.config/llama.cpp/presets.ini; the router loads a model on demand, so
  ;; there is no need to `make llama_load' first — but it must be RUNNING
  ;; (`make llama_serve'), else requests fail with a connection error rather
  ;; than falling back to Claude.
  ;; `:key' is required by gptel but ignored by the router.
  ;; NB the model list is static here: add new preset aliases by hand, unlike
  ;; pi which discovers them from the router. Names must match the [section]
  ;; names in presets.ini exactly — that is what /v1/models reports.
  (setq gptel-backend
        (gptel-make-openai "llama.cpp"
          :host "127.0.0.1:{{ dig "llama_port" "9931" . }}"
          :protocol "http"
          :endpoint "/v1/chat/completions"
          :stream t
          :key "local"
          :models '(qwen3-coder-30b qwen3.6-35b)))
  (setq gptel-model '{{ dig "llama_preload" "qwen3.6-35b" . }})
  (setq gptel-default-mode 'org-mode)

  ;; Follow the response while it streams and land point at its end when done.
  ;; Both hooks are nil upstream, so without this the window sits still while
  ;; text scrolls out of view — the more noticeable the slower the model.
  ;; NB `gptel-auto-scroll' moves the cursor (its own docstring says so).
  (add-hook 'gptel-post-stream-hook #'gptel-auto-scroll)
  (add-hook 'gptel-post-response-functions #'gptel-end-of-response))

(provide 'init-gptel)
