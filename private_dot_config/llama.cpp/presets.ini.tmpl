; -*- mode: conf-windows; -*-
; llama.cpp router presets. Read via LLAMA_ARG_MODELS_PRESET (shell/exports.sh).
; Keys are llama-server long options without the leading "--".
; Weights live outside the dotfiles; this file only points at them.
;
; Local paths rather than hf-repo: no network fetch at load time, and no
; duplicate auto-discovered entry that would ignore the flags below.
; Every section pins ctx-size and cache-type — the default is the model's full
; trained context, whose KV cache does not fit.

; MoE, 8 of 256 experts active. General model, not coder-tuned.
; Thinking model: reasoning stays enabled. Disabling it is not equivalent to
; using a non-thinking model — prefer qwen3-coder-30b for code.
[qwen3.6-35b]
model = {{ dig "llama_models" (printf "%s/.cache/llama.cpp" .chezmoi.homeDir) . }}/gguf/qwen3.6-35b-a3b-UD-IQ3_S.gguf
; 65536 rather than 32768: only 2 KV heads over 40 layers, so KV costs ~0.35 GiB
; here versus ~0.85 GiB for the 30B at the same length. Agents reading files
; overflow 32k easily.
ctx-size = 65536
gpu-layers = 99
cache-type-k = q4_0
cache-type-v = q4_0
; thoughts into reasoning_content; `auto' mis-split this template
reasoning-format = deepseek
; runaway guard, not a limit
reasoning-budget = 4096

; MoE, ~3B of 30B active. Not a thinking model, so no reasoning overhead.
; ctx 32768 because pi sends a large system prompt before the first message;
; 16384 returned exceed_context_size_error.
[qwen3-coder-30b]
model = {{ dig "llama_models" (printf "%s/.cache/llama.cpp" .chezmoi.homeDir) . }}/gguf/qwen3-coder-30b-A3B-UD-Q3_K_XL.gguf
ctx-size = 32768
gpu-layers = 99
cache-type-k = q4_0
cache-type-v = q4_0

; Dense 27B, thinking model. Slower than the A3B MoEs, stronger on
; long-horizon agentic work and writing. Sampling per Unsloth thinking-mode
; recommendation.
[qwen3.8-27b]
model = {{ dig "llama_models" (printf "%s/.cache/llama.cpp" .chezmoi.homeDir) . }}/gguf/Qwen3.8-27B-UD-IQ4_XS.gguf
ctx-size = 32768
gpu-layers = 99
cache-type-k = q4_0
cache-type-v = q4_0
; `auto' splits this template correctly (verified), unlike qwen3.6
reasoning-format = auto
reasoning-budget = 4096
temp = 1.0
top-p = 0.95
top-k = 20
presence-penalty = 1.5
